# Copy to .env (git-ignored) and change every value marked CHANGE_ME.
# The backend reads this file via `node --env-file-if-exists=../.env`;
# docker compose reads it automatically from this directory.

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=4000

# --- AI service (internal only, never exposed to the browser) ---
AI_SERVICE_PORT=8001

# --- MySQL (docker compose) ---
MYSQL_PORT=3306
MYSQL_DATABASE=evoting
MYSQL_USER=evoting
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
