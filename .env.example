# Copy to .env (git-ignored) and change every value marked CHANGE_ME.
# The backend reads this file via `node --env-file-if-exists=../.env`;
# docker compose reads it automatically from this directory.

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=4000

# --- AI service (internal only, never exposed to the browser) ---
AI_SERVICE_PORT=8001

# --- MySQL (docker compose) ---
MYSQL_PORT=3306
MYSQL_DATABASE=evoting
MYSQL_USER=evoting
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- Database (Prisma). Use the same user/password as above. ---
DATABASE_URL=mysql://evoting:CHANGE_ME@localhost:3306/evoting
# Integration tests wipe this database — never point it at real data.
TEST_DATABASE_URL=mysql://evoting:CHANGE_ME@localhost:3306/evoting_test

# --- Auth ---
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=CHANGE_ME
REFRESH_TOKEN_TTL_DAYS=7
# Exact origin of the frontend (CORS + cookies)
CORS_ORIGIN=http://localhost:5173

# --- First admin, created by `npm run db:seed` (password: 12+ characters) ---
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME

# --- Mail (admin login OTP) ---
# Leave SMTP_URL empty in development: emails are written to backend/.dev-mail/ instead.
# Required in production, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=E-Voting <no-reply@example.com>
